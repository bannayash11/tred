//@version=6
indicator("NIFTY 50 Mechanical Trading System v1", overlay=true, max_labels_count=500, max_lines_count=500)

//====================================================
// 1. INPUTS
//====================================================

groupTrend = "1. Multi-Timeframe Trend"
tf15 = input.timeframe("15", "15-minute timeframe", group=groupTrend)
tf60 = input.timeframe("60", "1-hour timeframe", group=groupTrend)
tfD  = input.timeframe("D", "Daily timeframe", group=groupTrend)
tfW  = input.timeframe("W", "Weekly timeframe", group=groupTrend)

requireMain = input.bool(true, "Require Daily + Weekly agreement", group=groupTrend)
requireConfirm = input.bool(true, "Require 1H + 15m confirmation", group=groupTrend)

groupSetup = "2. Entry Setup"
maxPendingBars = input.int(5, "Setup expiry (bars)", minval=1, group=groupSetup)
oneTradeOnly = input.bool(true, "One active trade at a time", group=groupSetup)
rr = input.float(2.0, "Target risk/reward", minval=0.5, step=0.25, group=groupSetup)

groupExit = "3. Exit Rules"
exitOnOpposite = input.bool(true, "Exit on opposite reversal pattern", group=groupExit)

groupVisual = "4. Chart Display"
showBackground = input.bool(true, "Show trend background", group=groupVisual)
showDashboard = input.bool(true, "Show MTF dashboard", group=groupVisual)
showSetupLabels = input.bool(true, "Show setup labels", group=groupVisual)
showTradeLabels = input.bool(true, "Show entry and exit labels", group=groupVisual)
showLevels = input.bool(true, "Show entry / SL / target lines", group=groupVisual)
highlightCandles = input.bool(true, "Highlight important candles", group=groupVisual)

bullColor = input.color(color.lime, "Bullish color", group=groupVisual)
bearColor = input.color(color.red, "Bearish color", group=groupVisual)
neutralColor = input.color(color.gray, "Neutral color", group=groupVisual)
setupColor = input.color(color.aqua, "Setup candle color", group=groupVisual)
entryColor = input.color(color.blue, "Entry candle color", group=groupVisual)
exitColor = input.color(color.orange, "Exit candle color", group=groupVisual)
bgTransparency = input.int(90, "Background transparency", minval=0, maxval=100, group=groupVisual)

//====================================================
// 2. OBJECTIVE TREND LOGIC
//====================================================

f_trend() =>
    var int trend = 0
    bullReversal = high > high[1] and low > low[1] and close > high[1]
    bearReversal = high < high[1] and low < low[1] and close < low[1]
    if bullReversal
        trend := 1
    else if bearReversal
        trend := -1
    trend

trend15 = request.security(syminfo.tickerid, tf15, f_trend()[1], lookahead=barmerge.lookahead_on)
trend60 = request.security(syminfo.tickerid, tf60, f_trend()[1], lookahead=barmerge.lookahead_on)
trendD  = request.security(syminfo.tickerid, tfD, f_trend()[1], lookahead=barmerge.lookahead_on)
trendW  = request.security(syminfo.tickerid, tfW, f_trend()[1], lookahead=barmerge.lookahead_on)
chartTrend = f_trend()

//====================================================
// 3. MULTI-TIMEFRAME ALIGNMENT
//====================================================

mainBull = trendD == 1 and trendW == 1
mainBear = trendD == -1 and trendW == -1
confirmBull = trend60 == 1 and trend15 == 1
confirmBear = trend60 == -1 and trend15 == -1
bullAllowed = (not requireMain or mainBull) and (not requireConfirm or confirmBull)
bearAllowed = (not requireMain or mainBear) and (not requireConfirm or confirmBear)
tradeDirection = bullAllowed ? 1 : bearAllowed ? -1 : 0

//====================================================
// 4. TWO-CANDLE CONFIRMATION
//====================================================

bullCandle1 = high[1] > high[2] and low[1] > low[2]
bullCandle2 = high > high[1] and low > low[1] and close > high[1]
bullSetup = bullCandle1 and bullCandle2

bearCandle1 = high[1] < high[2] and low[1] < low[2]
bearCandle2 = high < high[1] and low < low[1] and close < low[1]
bearSetup = bearCandle1 and bearCandle2

bullReversal = high > high[1] and low > low[1] and close > high[1]
bearReversal = high < high[1] and low < low[1] and close < low[1]

//====================================================
// 5. TRADE STATE
//====================================================

var int pendingDir = 0
var float pendingEntry = na
var float pendingSL = na
var int pendingBar = na

var bool inTrade = false
var int tradeDir = 0
var float activeEntry = na
var float activeSL = na
var float activeTarget = na

var line entryLine = na
var line stopLine = na
var line targetLine = na

bool buyEvent = false
bool sellEvent = false
bool exitEvent = false
bool targetEvent = false
bool stopEvent = false
bool setupEvent = false

confirmed = barstate.isconfirmed
is5m = timeframe.isminutes and timeframe.multiplier == 5

//====================================================
// 6. MANAGE EXISTING TRADE
//====================================================

if confirmed and inTrade
    bool hitSL = tradeDir == 1 ? low <= activeSL : high >= activeSL
    bool hitTarget = tradeDir == 1 ? high >= activeTarget : low <= activeTarget
    bool oppositeExit = exitOnOpposite and (tradeDir == 1 ? bearReversal : bullReversal)

    if hitSL
        stopEvent := true
        exitEvent := true
        float exitPrice = tradeDir == 1 and open < activeSL ? open : tradeDir == -1 and open > activeSL ? open : activeSL
        if showTradeLabels
            label.new(bar_index, exitPrice, "STOP LOSS", style=tradeDir == 1 ? label.style_label_down : label.style_label_up, color=color.red, textcolor=color.white)
        inTrade := false
        tradeDir := 0
    else if hitTarget
        targetEvent := true
        exitEvent := true
        if showTradeLabels
            label.new(bar_index, activeTarget, "TARGET HIT", style=label.style_label_left, color=color.green, textcolor=color.white)
        inTrade := false
        tradeDir := 0
    else if oppositeExit
        exitEvent := true
        if showTradeLabels
            label.new(bar_index, close, "OPPOSITE SIGNAL EXIT", style=label.style_label_left, color=exitColor, textcolor=color.white)
        inTrade := false
        tradeDir := 0

//====================================================
// 7. CREATE A NEW SETUP
//====================================================

canCreateSetup = confirmed and is5m and (not inTrade or not oneTradeOnly) and pendingDir == 0

if canCreateSetup
    if bullSetup and bullAllowed
        pendingDir := 1
        pendingEntry := high
        pendingSL := low
        pendingBar := bar_index
        setupEvent := true
        if showSetupLabels
            label.new(bar_index, low, "BULLISH SETUP\nBreak above high", style=label.style_label_up, color=bullColor, textcolor=color.black)
    else if bearSetup and bearAllowed
        pendingDir := -1
        pendingEntry := low
        pendingSL := high
        pendingBar := bar_index
        setupEvent := true
        if showSetupLabels
            label.new(bar_index, high, "BEARISH SETUP\nBreak below low", style=label.style_label_down, color=bearColor, textcolor=color.white)

//====================================================
// 8. PENDING SETUP MANAGEMENT
//====================================================

if confirmed and pendingDir != 0 and bar_index > pendingBar
    bool expired = bar_index - pendingBar > maxPendingBars
    bool invalid = pendingDir == 1 ? close <= pendingSL : close >= pendingSL
    if expired or invalid or (pendingDir == 1 and not bullAllowed) or (pendingDir == -1 and not bearAllowed)
        pendingDir := 0
        pendingEntry := na
        pendingSL := na
        pendingBar := na

//====================================================
// 9. ENTRY EXECUTION
//====================================================

if confirmed and is5m and (not inTrade or not oneTradeOnly) and pendingDir != 0 and bar_index > pendingBar
    bool breakout = pendingDir == 1 ? high >= pendingEntry : low <= pendingEntry
    if breakout
        float fillPrice = pendingDir == 1 ? math.max(open, pendingEntry) : math.min(open, pendingEntry)
        float risk = pendingDir == 1 ? fillPrice - pendingSL : pendingSL - fillPrice
        if risk > syminfo.mintick
            inTrade := true
            tradeDir := pendingDir
            activeEntry := fillPrice
            activeSL := pendingSL
            activeTarget := pendingDir == 1 ? fillPrice + risk * rr : fillPrice - risk * rr
            buyEvent := pendingDir == 1
            sellEvent := pendingDir == -1
            if showTradeLabels
                label.new(bar_index, fillPrice, pendingDir == 1 ? "BUY" : "SELL", style=pendingDir == 1 ? label.style_label_up : label.style_label_down, color=pendingDir == 1 ? bullColor : bearColor, textcolor=color.white)
            if showLevels
                line.delete(entryLine)
                line.delete(stopLine)
                line.delete(targetLine)
                entryLine := line.new(bar_index, activeEntry, bar_index + 1, activeEntry, extend=extend.right, color=color.blue, width=2)
                stopLine := line.new(bar_index, activeSL, bar_index + 1, activeSL, extend=extend.right, color=color.red, width=2)
                targetLine := line.new(bar_index, activeTarget, bar_index + 1, activeTarget, extend=extend.right, color=color.green, width=2)
        pendingDir := 0
        pendingEntry := na
        pendingSL := na
        pendingBar := na

//====================================================
// 10. VISUALS
//====================================================

bgColor = tradeDirection == 1 ? color.new(bullColor, bgTransparency) : tradeDirection == -1 ? color.new(bearColor, bgTransparency) : na
bgcolor(showBackground ? bgColor : na)

color candleColor = na
if highlightCandles
    if buyEvent or sellEvent
        candleColor := entryColor
    else if exitEvent
        candleColor := exitColor
    else if setupEvent
        candleColor := setupColor
    else if chartTrend == 1
        candleColor := bullColor
    else if chartTrend == -1
        candleColor := bearColor
barcolor(candleColor)

//====================================================
// 11. MTF DASHBOARD
//====================================================

f_status(int value) =>
    value == 1 ? "BULLISH" : value == -1 ? "BEARISH" : "NEUTRAL"

f_statusColor(int value) =>
    value == 1 ? color.green : value == -1 ? color.red : color.gray

var table dashboard = table.new(position.top_right, 2, 7, border_width=1)

if barstate.islast and showDashboard
    table.cell(dashboard, 0, 0, "TIMEFRAME", bgcolor=color.black, text_color=color.white)
    table.cell(dashboard, 1, 0, "TREND", bgcolor=color.black, text_color=color.white)
    table.cell(dashboard, 0, 1, "15m")
    table.cell(dashboard, 1, 1, f_status(trend15), bgcolor=f_statusColor(trend15), text_color=color.white)
    table.cell(dashboard, 0, 2, "1H")
    table.cell(dashboard, 1, 2, f_status(trend60), bgcolor=f_statusColor(trend60), text_color=color.white)
    table.cell(dashboard, 0, 3, "Daily")
    table.cell(dashboard, 1, 3, f_status(trendD), bgcolor=f_statusColor(trendD), text_color=color.white)
    table.cell(dashboard, 0, 4, "Weekly")
    table.cell(dashboard, 1, 4, f_status(trendW), bgcolor=f_statusColor(trendW), text_color=color.white)
    table.cell(dashboard, 0, 5, "Bias")
    table.cell(dashboard, 1, 5, tradeDirection == 1 ? "LONG" : tradeDirection == -1 ? "SHORT" : "FLAT", bgcolor=tradeDirection == 0 ? color.gray : tradeDirection == 1 ? color.green : color.red, text_color=color.white)
    table.cell(dashboard, 0, 6, "Chart")
    table.cell(dashboard, 1, 6, is5m ? "5m OK" : "USE 5m", bgcolor=is5m ? color.green : color.orange, text_color=color.white)

plotshape(buyEvent, title="Buy", style=shape.triangleup, location=location.belowbar, color=bullColor, size=size.small)
plotshape(sellEvent, title="Sell", style=shape.triangledown, location=location.abovebar, color=bearColor, size=size.small)
