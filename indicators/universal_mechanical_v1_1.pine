//@version=6
indicator("Universal Mechanical Trading System v1.1", overlay=true, max_labels_count=500, max_lines_count=500)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 1. TIMEFRAME SETTINGS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

gTF = "1. Multi-Timeframe Settings"

use15 = input.bool(true, "Enable TF 1", inline="a", group=gTF)
tf15 = input.timeframe("15", "TF 1", inline="a", group=gTF)

use60 = input.bool(true, "Enable TF 2", inline="b", group=gTF)
tf60 = input.timeframe("60", "TF 2", inline="b", group=gTF)

useD = input.bool(true, "Enable TF 3", inline="c", group=gTF)
tfD = input.timeframe("D", "TF 3", inline="c", group=gTF)

useW = input.bool(true, "Enable TF 4", inline="d", group=gTF)
tfW = input.timeframe("W", "TF 4", inline="d", group=gTF)

requireAll = input.bool(true, "All enabled timeframes must agree", group=gTF)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 2. TRADE SETTINGS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

gTrade = "2. Trade Settings"

rr = input.float(2.0, "Target Risk/Reward", minval=0.5, step=0.25, group=gTrade)
expiry = input.int(5, "Setup expiry (chart bars)", minval=1, group=gTrade)
oneTrade = input.bool(true, "One active trade at a time", group=gTrade)
exitOpposite = input.bool(true, "Exit on opposite reversal", group=gTrade)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 3. VISUAL SETTINGS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

gVisual = "3. Visual Settings"

showBG = input.bool(true, "Trend background", group=gVisual)
showDashboard = input.bool(true, "MTF dashboard", group=gVisual)
showLabels = input.bool(true, "Entry and exit labels", group=gVisual)
showLevels = input.bool(true, "Entry / SL / Target lines", group=gVisual)
showSetups = input.bool(true, "Setup labels", group=gVisual)
showCandles = input.bool(true, "Highlight candles", group=gVisual)

bullColor = input.color(color.lime, "Bullish", group=gVisual)
bearColor = input.color(color.red, "Bearish", group=gVisual)
neutralColor = input.color(color.gray, "Neutral", group=gVisual)
setupColor = input.color(color.aqua, "Setup", group=gVisual)
entryColor = input.color(color.blue, "Entry", group=gVisual)
exitColor = input.color(color.orange, "Exit", group=gVisual)
bgTrans = input.int(90, "Background transparency", minval=0, maxval=100, group=gVisual)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 4. TREND LOGIC
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

f_trend() =>
    var int trend = 0
    bool bull = high > high[1] and low > low[1] and close > high[1]
    bool bear = high < high[1] and low < low[1] and close < low[1]
    if bull
        trend := 1
    else if bear
        trend := -1
    trend

f_htf(string tf) =>
    request.security(syminfo.tickerid, tf, f_trend()[1], lookahead=barmerge.lookahead_on)

chartSeconds = timeframe.in_seconds()
sec15 = timeframe.in_seconds(tf15)
sec60 = timeframe.in_seconds(tf60)
secD = timeframe.in_seconds(tfD)
secW = timeframe.in_seconds(tfW)

if (use15 and sec15 < chartSeconds) or (use60 and sec60 < chartSeconds) or (useD and secD < chartSeconds) or (useW and secW < chartSeconds)
    runtime.error("Enabled trend timeframes must be equal to or higher than the chart timeframe. Change the MTF settings.")

t15 = use15 ? f_htf(tf15) : 0
t60 = use60 ? f_htf(tf60) : 0
tD = useD ? f_htf(tfD) : 0
tW = useW ? f_htf(tfW) : 0

chartTrend = f_trend()

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 5. MTF DIRECTION FILTER
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

enabledCount = (use15 ? 1 : 0) + (use60 ? 1 : 0) + (useD ? 1 : 0) + (useW ? 1 : 0)

bullCount = (use15 and t15 == 1 ? 1 : 0) + (use60 and t60 == 1 ? 1 : 0) + (useD and tD == 1 ? 1 : 0) + (useW and tW == 1 ? 1 : 0)
bearCount = (use15 and t15 == -1 ? 1 : 0) + (use60 and t60 == -1 ? 1 : 0) + (useD and tD == -1 ? 1 : 0) + (useW and tW == -1 ? 1 : 0)

bullAllowed = enabledCount > 0 and (requireAll ? bullCount == enabledCount : bullCount > bearCount)
bearAllowed = enabledCount > 0 and (requireAll ? bearCount == enabledCount : bearCount > bullCount)
direction = bullAllowed ? 1 : bearAllowed ? -1 : 0

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 6. REVERSAL AND CONFIRMATION PATTERNS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bullReversal = high > high[1] and low > low[1] and close > high[1]
bearReversal = high < high[1] and low < low[1] and close < low[1]

bullC1 = high[1] > high[2] and low[1] > low[2]
bullC2 = high > high[1] and low > low[1] and close > high[1]
bullSetup = bullC1 and bullC2

bearC1 = high[1] < high[2] and low[1] < low[2]
bearC2 = high < high[1] and low < low[1] and close < low[1]
bearSetup = bearC1 and bearC2

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 7. TRADE VARIABLES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var int pendingDir = 0
var float pendingEntry = na
var float pendingSL = na
var int pendingBar = na

var bool inTrade = false
var int tradeDir = 0
var float activeEntry = na
var float activeSL = na
var float activeTarget = na

var line entryLine = na
var line slLine = na
var line targetLine = na

bool buyEvent = false
bool sellEvent = false
bool stopEvent = false
bool targetEvent = false
bool oppositeEvent = false
bool setupEvent = false

confirmed = barstate.isconfirmed

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 8. EXISTING TRADE MANAGEMENT
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if confirmed and inTrade
    bool hitSL = tradeDir == 1 ? low <= activeSL : high >= activeSL
    bool hitTarget = tradeDir == 1 ? high >= activeTarget : low <= activeTarget
    bool opposite = exitOpposite and (tradeDir == 1 ? bearReversal : bullReversal)

    if hitSL
        stopEvent := true
        float fill = tradeDir == 1 and open < activeSL ? open : tradeDir == -1 and open > activeSL ? open : activeSL
        if showLabels
            label.new(bar_index, fill, "STOP LOSS", color=color.red, textcolor=color.white)
        inTrade := false
        tradeDir := 0
    else if hitTarget
        targetEvent := true
        if showLabels
            label.new(bar_index, activeTarget, "TARGET HIT", color=color.green, textcolor=color.white)
        inTrade := false
        tradeDir := 0
    else if opposite
        oppositeEvent := true
        if showLabels
            label.new(bar_index, close, "OPPOSITE EXIT", color=exitColor, textcolor=color.white)
        inTrade := false
        tradeDir := 0

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 9. NEW SETUP
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

canSetup = confirmed and (not inTrade or not oneTrade) and pendingDir == 0

if canSetup
    if bullSetup and bullAllowed
        pendingDir := 1
        pendingEntry := high
        pendingSL := low
        pendingBar := bar_index
        setupEvent := true
        if showSetups
            label.new(bar_index, low, "BULLISH SETUP", style=label.style_label_up, color=bullColor, textcolor=color.black)
    else if bearSetup and bearAllowed
        pendingDir := -1
        pendingEntry := low
        pendingSL := high
        pendingBar := bar_index
        setupEvent := true
        if showSetups
            label.new(bar_index, high, "BEARISH SETUP", style=label.style_label_down, color=bearColor, textcolor=color.white)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 10. SETUP INVALIDATION / EXPIRY
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if confirmed and pendingDir != 0 and bar_index > pendingBar
    bool expired = bar_index - pendingBar > expiry
    bool invalid = pendingDir == 1 ? close <= pendingSL : close >= pendingSL
    bool trendLost = pendingDir == 1 ? not bullAllowed : not bearAllowed
    if expired or invalid or trendLost
        pendingDir := 0
        pendingEntry := na
        pendingSL := na
        pendingBar := na

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 11. BREAKOUT ENTRY
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if confirmed and pendingDir != 0 and bar_index > pendingBar and (not inTrade or not oneTrade)
    bool breakout = pendingDir == 1 ? high >= pendingEntry : low <= pendingEntry
    if breakout
        float fillPrice = pendingDir == 1 ? math.max(open, pendingEntry) : math.min(open, pendingEntry)
        float risk = pendingDir == 1 ? fillPrice - pendingSL : pendingSL - fillPrice
        if risk > syminfo.mintick
            inTrade := true
            tradeDir := pendingDir
            activeEntry := fillPrice
            activeSL := pendingSL
            activeTarget := pendingDir == 1 ? fillPrice + risk * rr : fillPrice - risk * rr
            buyEvent := pendingDir == 1
            sellEvent := pendingDir == -1
            if showLabels
                label.new(bar_index, fillPrice, pendingDir == 1 ? "BUY" : "SELL", style=pendingDir == 1 ? label.style_label_up : label.style_label_down, color=pendingDir == 1 ? bullColor : bearColor, textcolor=color.white)
            if showLevels
                line.delete(entryLine)
                line.delete(slLine)
                line.delete(targetLine)
                entryLine := line.new(bar_index, activeEntry, bar_index + 1, activeEntry, extend=extend.right, color=color.blue, width=2)
                slLine := line.new(bar_index, activeSL, bar_index + 1, activeSL, extend=extend.right, color=color.red, width=2)
                targetLine := line.new(bar_index, activeTarget, bar_index + 1, activeTarget, extend=extend.right, color=color.green, width=2)
        pendingDir := 0
        pendingEntry := na
        pendingSL := na
        pendingBar := na

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 12. BACKGROUND AND CANDLE COLORS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bg = direction == 1 ? color.new(bullColor, bgTrans) : direction == -1 ? color.new(bearColor, bgTrans) : na
bgcolor(showBG ? bg : na)

color candleCol = na
if showCandles
    if buyEvent or sellEvent
        candleCol := entryColor
    else if stopEvent or targetEvent or oppositeEvent
        candleCol := exitColor
    else if setupEvent
        candleCol := setupColor
    else if chartTrend == 1
        candleCol := bullColor
    else if chartTrend == -1
        candleCol := bearColor
barcolor(candleCol)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 13. DASHBOARD
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

f_status(int v) =>
    v == 1 ? "BULLISH" : v == -1 ? "BEARISH" : "NEUTRAL"

f_color(int v) =>
    v == 1 ? color.green : v == -1 ? color.red : neutralColor

var table dash = table.new(position.top_right, 2, 7, border_width=1)

if barstate.islast and showDashboard
    table.cell(dash, 0, 0, "TIMEFRAME", bgcolor=color.black, text_color=color.white)
    table.cell(dash, 1, 0, "TREND", bgcolor=color.black, text_color=color.white)

    table.cell(dash, 0, 1, use15 ? tf15 : "TF 1 OFF")
    table.cell(dash, 1, 1, use15 ? f_status(t15) : "OFF", bgcolor=use15 ? f_color(t15) : color.gray, text_color=color.white)

    table.cell(dash, 0, 2, use60 ? tf60 : "TF 2 OFF")
    table.cell(dash, 1, 2, use60 ? f_status(t60) : "OFF", bgcolor=use60 ? f_color(t60) : color.gray, text_color=color.white)

    table.cell(dash, 0, 3, useD ? tfD : "TF 3 OFF")
    table.cell(dash, 1, 3, useD ? f_status(tD) : "OFF", bgcolor=useD ? f_color(tD) : color.gray, text_color=color.white)

    table.cell(dash, 0, 4, useW ? tfW : "TF 4 OFF")
    table.cell(dash, 1, 4, useW ? f_status(tW) : "OFF", bgcolor=useW ? f_color(tW) : color.gray, text_color=color.white)

    table.cell(dash, 0, 5, "Bias")
    table.cell(dash, 1, 5, direction == 1 ? "LONG" : direction == -1 ? "SHORT" : "FLAT", bgcolor=direction == 0 ? color.gray : direction == 1 ? color.green : color.red, text_color=color.white)

    table.cell(dash, 0, 6, "Status")
    table.cell(dash, 1, 6, inTrade ? "IN TRADE" : pendingDir != 0 ? "PENDING" : "IDLE", bgcolor=inTrade ? color.blue : pendingDir != 0 ? color.aqua : color.gray, text_color=color.white)

plotshape(buyEvent, title="Buy", style=shape.triangleup, location=location.belowbar, color=bullColor, size=size.small)
plotshape(sellEvent, title="Sell", style=shape.triangledown, location=location.abovebar, color=bearColor, size=size.small)
