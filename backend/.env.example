PORT=5001
# LIVE: use MongoDB Atlas (or any persistent Mongo). Do NOT use 127.0.0.1 on Hostinger —
# local DB is empty after every deploy, so users must sign up again.
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/tradrift_db?retryWrites=true&w=majority
# Alias also supported (e.g. Hostinger): MONGODB_URI=...
REQUIRE_MONGO=1
# Required in production (16+ random chars). Keep the SAME value across deploys or all sessions die.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
REQUIRE_JWT_SECRET=0
# Dev only — memory users are wiped on restart/deploy. Never enable on live.
ALLOW_MEMORY_AUTH=0
# Optional first-admin bootstrap (never commit real passwords)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_SUBADMIN_EMAIL=
SEED_SUBADMIN_PASSWORD=
# Dev only: log 2FA / recovery codes to console (never enable in production)
AUTH_DEBUG_CODES=0

# Optional SMTP bootstrap (admin panel can override & persist in DB)
SMTP_ENABLED=1
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Tradrift
SMTP_FROM_EMAIL=

CORS_ORIGINS=http://localhost:3003,http://localhost:3004,https://darkslateblue-dotterel-519318.hostingersite.com
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Kotak Neo — live market + Order Flow (option chain / futures) [preferred]
KOTAK_CONSUMER_KEY=
KOTAK_UCC=
KOTAK_MOBILE_NUMBER=
KOTAK_MPIN=
KOTAK_TOTP_KEY=
# Multi-user Kotak pacing (optional)
KOTAK_REQUEST_GAP_MS=280
KOTAK_QUOTE_POLL_MS=3000

# Order Flow provider: auto (Kotak first, Upstox fallback) | kotak | upstox
ORDER_FLOW_PROVIDER=auto

# Upstox — Order Flow fallback when Kotak login/rate-limit fails
# Daily access token from Upstox developer OAuth
UPSTOX_ACCESS_TOKEN=

# Razorpay Payment Gateway (Dashboard → Settings → API Keys / Webhooks)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
# Webhook secret from Razorpay Dashboard → Webhooks (events: payment.captured, payment.failed)
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxx

# Manual UPI / UTR (optional alternative to Razorpay — admin verifies then activates membership)
UTR_PAYMENTS_ENABLED=1
UTR_UPI_ID=yourbusiness@upi
UTR_PAYEE_NAME=Tradrift
# Optional public image URL for QR code shown at checkout
UTR_QR_IMAGE_URL=
UTR_INSTRUCTIONS=Pay the exact plan amount via UPI, then paste the UTR / UPI reference number.

